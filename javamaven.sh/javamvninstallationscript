
This code is a shell script that installs Java 11 and Maven 3 on a Linux system. It checks if Java and Maven are already installed, and if not, it prompts the user for the version to install. The script then downloads the necessary files, extracts them, sets environment variables, and verifies the installation.


#!/bin/bash

########################
##installing java-11
########################
#exit on error
set -e

echo "starting installation of java-11"
if ! command -v java &> /dev/null; then
     echo "java is not installed..."
     read -p "enter java version to install (only java 11):" java_version

     if [ "$java_version" = "11" ]; then
     sudo yum install wget -y #if not installed
     wget https://download.java.net/java/GA/jdk11/9/GPL/openjdk-11.0.2_linux-x64_bin.tar.gz
     tar -xvzf openjdk-11.0.2_linux-x64_bin.tar.gz
     sudo mv jdk-11.0.2 /opt/java-11
     rm openjdk-11.0.2_linux-x64_bin.tar.gz  #remove once exracted



     #set JAVA_HOME and PATH
     echo "updating system level for all the user"
     sudo tee /etc/profile.d/java.sh <<EOF
export JAVA_HOME=/opt/java-11
export PATH=\$JAVA_HOME/bin:\$PATH
EOF

     source /etc/profile.d/java.sh #always source the file once you set the path

       #verify installation
       if command -v java  &> /dev/null; then
          JAVA_PATH=$(dirname "$(dirname "$(readlink -f "$(which java)")")")
          echo "java installed at $JAVA_PATH"
       else
          echo "java installation failed. Aborting....."
          exit 1

       fi

   else

      echo "unsupported java version: $java_version.only java 11 is supported."
   exit 1

     fi

else
        echo "Java is already installed."
        java -version
	
fi	
	
		  
		  

##########################
#installing maven-3
##########################

echo "starting installation of maven-3"	
# Go to /opt (as a root)
cd /opt
if ! command -v mvn &> /dev/null; then
     echo "maven is not installed"
	 read -p "enter maven version to install (only maven 3):" maven_version
	 if [ "$maven_version" = "3" ]; then
	 sudo yum install -y wget unzip
	 wget https://dlcdn.apache.org/maven/maven-3/3.9.10/binaries/apache-maven-3.9.10-bin.zip
	 unzip apache-maven-3.9.10-bin.zip
     rm apache-maven-3.9.10-bin.zip 
	 
#set M2_HOME and PATH
     echo "updating system level for all the user"
     sudo tee /etc/profile.d/mvn.sh > /dev/null <<EOF
export M2_HOME=/opt/apache-maven-3.9.10
export PATH=\$M2_HOME/bin:\$PATH
EOF

source /etc/profile.d/mvn.sh 

#verify installation
       if command -v mvn  &> /dev/null; then
          M2_HOME=$(dirname "$(dirname "$(readlink -f "$(which mvn)")")")
          echo "maven installed at $M2_HOME"
		  mvn --version
       else
          echo "maven installation failed. Aborting....."
          exit 1

       fi

   else

      echo "unsupported maven version: $maven_version. only Maven 3 is supported."
   exit 1

     fi

else
        echo "Maven is already installed."
        mvn --version
		
fi